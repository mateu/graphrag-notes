# GraphRAG Notes runtime configuration overrides.
# Copy to .env or export these before running the CLI/tests. Values here take
# precedence over a TOML configuration file; explicit CLI flags take priority
# over both. See `graphrag config show` for the resolved values.

# Optional path to the config file. Without it, GraphRAG Notes looks only for
# ~/.config/graphrag/config.toml; it never auto-loads ./config.toml.
# GRAPHRAG_CONFIG=~/.config/graphrag/config.toml
# GRAPHRAG_DB_PATH=~/.graphrag/data-v3
# GRAPHRAG_LOG_LEVEL=warn

# Runtime search, augmentation, Gardener, and Librarian overrides.
# GRAPHRAG_SEARCH_DEFAULT_LIMIT=10
# GRAPHRAG_SEARCH_FUSION_STRATEGY=rrf
# GRAPHRAG_SEARCH_RRF_K=60
# GRAPHRAG_SEARCH_VECTOR_WEIGHT=0.7
# GRAPHRAG_SEARCH_FULLTEXT_WEIGHT=0.3
# GRAPHRAG_SEARCH_CANDIDATE_POOL_MULTIPLIER=4
# GRAPHRAG_SEARCH_CANDIDATE_POOL_MIN=50
# GRAPHRAG_SEARCH_CANDIDATE_POOL_MAX=200
# GRAPHRAG_SEARCH_NOTE_WEIGHT=1.0
# GRAPHRAG_SEARCH_MESSAGE_WEIGHT=1.0
# GRAPHRAG_SEARCH_CONVERSATION_SUMMARY_WEIGHT=1.0
# GRAPHRAG_AUGMENT_DEFAULT_LIMIT=8
# GRAPHRAG_AUGMENT_MAX_TOKENS=1200
# GRAPHRAG_AUGMENT_MAX_CHUNK_TOKENS=180
# GRAPHRAG_GARDENER_SIMILARITY_THRESHOLD=0.7
# GRAPHRAG_GARDENER_AUTO_APPLY_THRESHOLD=0.85
# GRAPHRAG_GARDENER_MAX_SUGGESTIONS=50
# GRAPHRAG_LIBRARIAN_MIN_CHUNK_SIZE=50
# GRAPHRAG_LIBRARIAN_MAX_CHUNK_SIZE=1000
# GRAPHRAG_INFERENCE_TIMEOUT_SECS=30

# Use Ollama for both embeddings and extraction
TEI_PROVIDER=ollama
TGI_PROVIDER=ollama

# Local Ollama endpoint
TEI_URL=http://localhost:11434
TGI_URL=http://localhost:11434

# IMPORTANT: this repo expects 1024-dimension embeddings
# bge-m3 matches the schema; nomic-embed-text currently does not in this environment
TEI_MODEL=bge-m3:latest

# Local extraction model
TGI_MODEL=phi4-mini:latest

# Optional shared Ollama fallback URL. TEI_URL/TGI_URL win when set.
# OLLAMA_URL=http://localhost:11434

# Optional TEI batch-size override.
# TEI_MAX_BATCH=32

# Optional TEI request prompt names.
# TEI_PROMPT_NAME_QUERY=query
# TEI_PROMPT_NAME_PASSAGE=passage

# Optional extraction tuning. These legacy names map to [inference] settings.
# STRICT_ENTITY_JSON=true
# EXTRACT_MAX_ENTITIES=30
# EXTRACT_MAX_RELATIONSHIPS=15
# TGI_OLLAMA_TIMEOUT_SECS=120
# TGI_OLLAMA_OPTIONS={"temperature":0,"num_ctx":1024}

# Legacy Librarian controls. They map to [librarian] settings.
# SKIP_ENTITY_EXTRACTION=false
# EXTRACT_LOG_EACH=false
# EXTRACT_MAX_CHARS=8000  # 0 disables truncation
# EXTRACT_PROGRESS_EVERY=10
# EXTRACT_PROGRESS_EVERY_SECS=5
# IMPORT_PROGRESS_EVERY=10
# IMPORT_PROGRESS_EVERY_SECS=5
